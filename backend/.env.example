ENVIRONMENT=development
DEBUG=true

JWT_SECRET_KEY=troque-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

DATABASE_URL=postgresql+asyncpg://orbit:orbit@postgres:5432/orbit_ia
SYNC_DATABASE_URL=postgresql+psycopg2://orbit:orbit@postgres:5432/orbit_ia

REDIS_URL=redis://redis:6379/0

# Cerebro da IA: troque para sua API compativel OpenAI (ex: https://api.openai.com/v1)
# ou mantenha o Ollama local abaixo.
AI_BASE_URL=http://ollama:11434/v1
AI_API_KEY=ollama
AI_CHAT_MODEL=llama3
AI_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_DIM=768

WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=25

CORS_ORIGINS=http://localhost:3000
